# --- Сервер ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Браузер / антидетект ---
HEADLESS=true
MIN_DELAY=1.8
MAX_DELAY=4.6
MAX_RESULTS=1000
PAGE_SIZE=12

# --- Прокси (опционально, по одному на строку в JSON-массиве) ---
PROXIES=[]
ROTATE_EVERY=0

# --- Капча (резерв) ---
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha

# --- Второй проход по сайтам ---
ENRICH_SITES=true
SITE_TIMEOUT=6
ENRICH_CONCURRENCY=8

# --- БД ---
DATABASE_URL=sqlite+aiosqlite:///./data/yascraper.db
