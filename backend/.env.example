# --- Сервер ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Браузер / антидетект ---
HEADLESS=true
MIN_DELAY=1.8
MAX_DELAY=4.6
MAX_RESULTS=1000
PAGE_SIZE=12

# --- Прокси (опционально, по одному на строку в JSON-массиве) ---
PROXIES=[]
ROTATE_EVERY=0

# --- Капча (резерв) ---
CAPTCHA_API_KEY=
CAPTCHA_PROVIDER=2captcha

# --- Второй проход по сайтам ---
ENRICH_SITES=true
SITE_TIMEOUT=6
ENRICH_CONCURRENCY=8

# --- БД ---
DATABASE_URL=sqlite+aiosqlite:///./data/yascraper.db

# --- Персональные демо ИИ-ассистента (kb_assistant) ---
# Пусто => колонка «Демо» и кнопка в таблице скрыты, парсер работает как раньше.
# KB_API_KEY — значение API_KEY из backend/.env проекта kb_assistant.
# Порт 8001, а не 8000: 8000 занят бэкендом самого парсера.
KB_BASE_URL=http://127.0.0.1:8001
KB_API_KEY=
# username Telegram-бота, который обслуживает все демо (без @)
KB_BOT_USERNAME=
# сколько страниц сайта клиента краулить в базу знаний под демо
KB_MAX_PAGES=30
KB_TIMEOUT=20

# --- Отбор клиентов: вердикты по сайтам ---
# Провайдеры пробуются по очереди, пока кто-то не ответит. Ни одного не
# задано => работают только механика и проба сайта, вердиктов модели нет.
# Ключ Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Запасные ключи Gemini через запятую. Лимит бесплатного тира считается на
# проект, поэтому ключи с разных аккаунтов складываются.
GOOGLE_API_KEYS_EXTRA=
# Groq — бесплатный тир, быстрый: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter — бесплатные модели: https://openrouter.ai/keys
OPENROUTER_API_KEY=
